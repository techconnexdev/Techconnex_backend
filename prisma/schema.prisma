generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                            String                @id @default(uuid()) @db.Uuid
  email                         String                @unique
  password                      String
  role                          Role[]
  name                          String
  phone                         String?
  kycStatus                     KycStatus             @default(pending_verification)
  isVerified                    Boolean               @default(false)
  status                        UserStatus            @default(ACTIVE)
  createdAt                     DateTime              @default(now())
  /// WhatsApp / phone OTP ownership verified (registration or profile); required for phone login.
  phoneVerified                 Boolean               @default(false)
  /// Account was originally created via Google OAuth (password login requires a reset first).
  isGoogleAccount               Boolean               @default(false)
  matches                       AiMatch[]
  Dispute                       Dispute[]
  KycDocument                   KycDocument[]
  notifications                 Notification[]
  projectsAsCustomer            Project[]             @relation("CustomerProjects")
  projectsAsProvider            Project[]             @relation("ProviderProjects")
  Proposal                      Proposal[]
  providerProfile               ProviderProfile?
  resume                        Resume?
  reviewsReceived               Review[]              @relation("Recipient")
  reviewsGiven                  Review[]              @relation("Reviewer")
  ReviewReply                   ReviewReply[]
  settings                      Settings?
  customerProfile               CustomerProfile?
  conversationReportsAgainst    ConversationReport[]  @relation("ConversationReportsAgainst")
  conversationReportsByReporter ConversationReport[]  @relation("ConversationReportsByReporter")
  invoicesAsCustomer            Invoice[]             @relation("InvoicesAsCustomer")
  invoicesAsProvider            Invoice[]             @relation("InvoicesAsProvider")
  receivedMessages              Message[]             @relation("ReceivedMessages")
  sentMessages                  Message[]             @relation("SentMessages")
  pushSubscriptions             PushSubscription[]
  savedByProviders              SavedCompany[]        @relation("CompanySavedByProviders")
  savedCompanies                SavedCompany[]        @relation("UserSavedCompanies")
  savedByUsers                  SavedProvider[]       @relation("ProviderSavedByUsers")
  savedProviders                SavedProvider[]       @relation("UserSavedProviders")
  requests                      ServiceRequest[]      @relation("CustomerRequests")
  supportConversations          SupportConversation[]
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  title     String
  type      String
  content   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  metadata  Json?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
  @@index([userId])
  @@map("push_subscriptions")
}

model ProviderProfile {
  id                       String             @id @default(uuid()) @db.Uuid
  userId                   String             @unique @db.Uuid
  bio                      String?
  major                    String?            @db.VarChar(255)
  location                 String?
  hourlyRate               Float?
  availability             String?            @db.VarChar(50)
  languages                String[]
  website                  String?
  portfolioLinks           String[]
  profileImageUrl          String?            @map("profile_image_url")
  rating                   Decimal            @default(0.00) @db.Decimal(3, 2)
  totalReviews             Int                @default(0) @map("total_reviews")
  totalProjects            Int                @default(0) @map("total_projects")
  totalEarnings            Decimal            @default(0.00) @map("total_earnings") @db.Decimal(15, 2)
  viewsCount               Int                @default(0) @map("views_count")
  successRate              Decimal            @default(0.00) @map("success_rate") @db.Decimal(5, 2)
  responseTime             Int                @default(0) @map("response_time")
  isFeatured               Boolean            @default(false) @map("is_featured")
  completion               Int?
  skills                   String[]
  yearsExperience          Int?
  minimumProjectBudget     Decimal?           @map("minimum_project_budget") @db.Decimal(10, 2)
  maximumProjectBudget     Decimal?           @map("maximum_project_budget") @db.Decimal(10, 2)
  preferredProjectDuration String?            @map("preferred_project_duration") @db.VarChar(50)
  workPreference           String             @default("remote") @map("work_preference") @db.VarChar(50)
  teamSize                 Int                @default(1) @map("team_size")
  /// BNM FX snapshot at last save of hourly/budget currency or amounts (updated in place when provider edits).
  fxSnapshotDate           String?            @map("fx_snapshot_date") @db.VarChar(20)
  fxSnapshotSession        String?            @map("fx_snapshot_session") @db.VarChar(20)
  fxSnapshotQuote          String?            @map("fx_snapshot_quote") @db.VarChar(10)
  fxSnapshotRatesJson      Json?              @map("fx_snapshot_rates_json")
  createdAt                DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  certifications           Certification[]
  payoutMethods            PayoutMethod[]
  performance              PerformanceStat?
  portfolios               ProjectPortfolio[]
  user                     User               @relation(fields: [userId], references: [id])

  @@map("ProviderProfile")
}

model PayoutMethod {
  id                String           @id @default(cuid())
  providerProfileId String           @db.Uuid
  type              PayoutMethodType
  label             String?
  bankName          String?
  accountNumber     String?
  accountHolder     String?
  accountEmail      String?
  walletId          String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  providerProfile   ProviderProfile  @relation(fields: [providerProfileId], references: [id])
}

model Settings {
  id                 Int       @id @default(autoincrement())
  userId             String    @unique @db.Uuid
  emailNotifications Boolean   @default(true)
  smsNotifications   Boolean   @default(false)
  pushNotifications  Boolean   @default(true)
  projectUpdates     Boolean   @default(true)
  marketingEmails    Boolean   @default(false)
  weeklyReports      Boolean   @default(true)
  profileVisibility  String    @default("public")
  showEmail          Boolean   @default(false)
  showPhone          Boolean   @default(false)
  allowMessages      Boolean   @default(true)
  twoFactorEnabled   Boolean   @default(false)
  lastPasswordChange DateTime?
  deletedAt          DateTime?
  /// UI language: en | id | ar (matches Frontend/lib/i18n/locales)
  locale             String    @default("en") @db.VarChar(10)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  preferredCurrency  String    @default("MYR") @db.VarChar(3)
  user               User      @relation(fields: [userId], references: [id])
  payments           Payment[] @relation("PaymentToSettings")
}

model CustomerProfile {
  id                     String    @id @default(uuid()) @db.Uuid
  userId                 String    @unique @db.Uuid
  description            String?
  industry               String?
  location               String?
  website                String?
  profileImageUrl        String?   @map("profile_image_url")
  socialLinks            Json?
  languages              String[]
  companySize            String?   @map("company_size") @db.VarChar(50)
  employeeCount          Int?      @map("employee_count")
  establishedYear        Int?      @map("established_year")
  annualRevenue          Decimal?  @db.Decimal(12, 2)
  fundingStage           String?
  preferredContractTypes String[]
  averageBudgetRange     String?
  remotePolicy           String?
  hiringFrequency        String?
  categoriesHiringFor    String[]
  completion             Int?
  rating                 Float?    @default(0.0)
  reviewCount            Int?      @default(0)
  totalSpend             Decimal?  @db.Decimal(12, 2)
  projectsPosted         Int?      @default(0)
  lastActiveAt           DateTime?
  mission                String?
  values                 String[]
  benefits               Json?
  mediaGallery           String[]
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                   User      @relation(fields: [userId], references: [id])

  @@map("companies")
}

model Certification {
  id           String          @id @default(uuid()) @db.Uuid
  profileId    String          @db.Uuid
  name         String
  issuer       String
  issuedDate   DateTime
  verified     Boolean         @default(false)
  serialNumber String?
  sourceUrl    String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @default(now()) @updatedAt
  profile      ProviderProfile @relation(fields: [profileId], references: [id])

  @@index([issuer])
  @@index([serialNumber])
}

model PerformanceStat {
  id             String          @id @default(uuid()) @db.Uuid
  profileId      String          @unique @db.Uuid
  totalProjects  Int             @default(0)
  completionRate Float           @default(0)
  onTimeDelivery Float           @default(0)
  responseTime   String          @default("N/A")
  repeatClients  Float           @default(0)
  profile        ProviderProfile @relation(fields: [profileId], references: [id])
}

model ProjectPortfolio {
  id          String          @id @default(uuid()) @db.Uuid
  profileId   String          @db.Uuid
  title       String
  description String
  techStack   String[]
  client      String?
  date        DateTime
  imageUrl    String?
  externalUrl String?
  profile     ProviderProfile @relation(fields: [profileId], references: [id])
}

model Review {
  id                    String        @id @default(uuid()) @db.Uuid
  projectId             String        @db.Uuid
  reviewerId            String        @db.Uuid
  recipientId           String        @db.Uuid
  company               String?
  role                  String?
  content               String
  rating                Float
  communicationRating   Int?          @map("communication_rating")
  qualityRating         Int?          @map("quality_rating")
  timelinessRating      Int?          @map("timeliness_rating")
  professionalismRating Int?          @map("professionalism_rating")
  createdAt             DateTime      @default(now())
  project               Project       @relation(fields: [projectId], references: [id])
  recipient             User          @relation("Recipient", fields: [recipientId], references: [id])
  reviewer              User          @relation("Reviewer", fields: [reviewerId], references: [id])
  ReviewReply           ReviewReply[]
}

model ReviewReply {
  id        String   @id @default(uuid()) @db.Uuid
  reviewId  String   @db.Uuid
  userId    String   @db.Uuid
  content   String
  createdAt DateTime @default(now())
  review    Review   @relation(fields: [reviewId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model Resume {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @db.Uuid
  fileUrl     String
  description String?
  uploadedAt  DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
}

model ServiceRequest {
  id                        String                    @id @default(uuid()) @db.Uuid
  title                     String
  description               String
  category                  String
  budgetMin                 Float
  budgetMax                 Float
  skills                    String[]
  timeline                  String?
  priority                  String?
  ndaSigned                 Boolean                   @default(false)
  requirements              String?
  deliverables              String?
  status                    RequestStatus             @default(OPEN)
  customerId                String                    @db.Uuid
  projectId                 String?                   @db.Uuid
  acceptedProposalId        String?                   @db.Uuid
  chosenMilestoneSource     MilestoneSource?
  milestoneDraft            Json?
  milestoneDraftVersion     Int                       @default(0)
  milestoneCompanyAccepted  Boolean                   @default(false)
  milestoneProviderAccepted Boolean                   @default(false)
  createdAt                 DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  currencyCode              String                    @default("MYR") @db.VarChar(3)
  fxSnapshotDate            String?                   @db.VarChar(20)
  fxSnapshotSession         String?                   @db.VarChar(20)
  fxSnapshotQuote           String?                   @db.VarChar(10)
  fxSnapshotRatesJson       Json?
  matches                   AiMatch[]
  proposals                 Proposal[]
  milestones                ServiceRequestMilestone[]
  customer                  User                      @relation("CustomerRequests", fields: [customerId], references: [id])
  project                   Project?                  @relation(fields: [projectId], references: [id])

  @@map("service_requests")
}

model ServiceRequestMilestone {
  id               String          @id @default(uuid()) @db.Uuid
  serviceRequestId String          @db.Uuid
  title            String
  description      String?
  amount           Float
  dueDate          DateTime?
  daysFromStart    Int?            @map("days_from_start")
  order            Int             @default(1)
  status           MilestoneStatus @default(PENDING)
  source           MilestoneSource @default(COMPANY)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  serviceRequest   ServiceRequest  @relation(fields: [serviceRequestId], references: [id])

  @@map("service_request_milestones")
}

model Proposal {
  id                   String              @id @default(uuid()) @db.Uuid
  providerId           String              @db.Uuid
  serviceRequestId     String              @db.Uuid
  bidAmount            Float?
  status               ProposalStatus      @default(PENDING)
  deliveryTime         Int
  coverLetter          String
  attachmentUrls       String[]            @default([])
  attachmentUrl        String?
  aiFitExplanation     Json?
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  bidAmountOriginal    Float?
  bidCurrencyCode      String              @default("MYR") @db.VarChar(3)
  bidConversionDate    String?             @db.VarChar(20)
  bidConversionSession String?             @db.VarChar(20)
  bidConversionQuote   String?             @db.VarChar(10)
  Milestone            Milestone[]
  provider             User                @relation(fields: [providerId], references: [id])
  serviceRequest       ServiceRequest      @relation(fields: [serviceRequestId], references: [id])
  milestones           ProposalMilestone[]
}

model ProposalMilestone {
  id            String          @id @default(uuid()) @db.Uuid
  proposalId    String          @db.Uuid
  title         String
  description   String?
  amount        Float
  dueDate       DateTime?
  daysFromStart Int?            @map("days_from_start")
  order         Int             @default(1)
  status        MilestoneStatus @default(PENDING)
  source        MilestoneSource @default(PROVIDER)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  proposal      Proposal        @relation(fields: [proposalId], references: [id])

  @@map("proposal_milestones")
}

model AiMatch {
  id         String         @id @default(uuid()) @db.Uuid
  requestId  String         @db.Uuid
  providerId String         @db.Uuid
  matchScore Float
  aiReason   String
  provider   User           @relation(fields: [providerId], references: [id])
  request    ServiceRequest @relation(fields: [requestId], references: [id])
}

model Project {
  id                   String           @id @default(uuid()) @db.Uuid
  title                String
  description          String
  category             String
  budgetMin            Float
  budgetMax            Float
  skills               String[]
  timeline             String?
  priority             String?
  ndaSigned            Boolean          @default(false)
  requirements         String?
  deliverables         String?
  status               ProjectStatus
  customerId           String           @db.Uuid
  providerId           String           @db.Uuid
  milestonesLocked     Boolean          @default(false) @map("milestones_locked")
  companyApproved      Boolean          @default(false) @map("company_approved")
  providerApproved     Boolean          @default(false) @map("provider_approved")
  milestonesApprovedAt DateTime?        @map("milestones_approved_at")
  startedAt            DateTime?        @map("started_at")
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  currencyCode         String           @default("MYR") @db.VarChar(3)
  fxSnapshotDate       String?          @db.VarChar(20)
  fxSnapshotSession    String?          @db.VarChar(20)
  fxSnapshotQuote      String?          @db.VarChar(10)
  fxSnapshotRatesJson  Json?
  Dispute              Dispute[]
  milestones           Milestone[]
  payments             Payment[]
  customer             User             @relation("CustomerProjects", fields: [customerId], references: [id])
  provider             User             @relation("ProviderProjects", fields: [providerId], references: [id])
  reviews              Review[]
  invoices             Invoice[]
  messages             Message[]
  ServiceRequest       ServiceRequest[]
}

model Invoice {
  id             String    @id @default(uuid()) @db.Uuid
  invoiceNumber  String    @unique @map("invoice_number") @db.VarChar(100)
  customerId     String    @map("customer_id") @db.Uuid
  providerId     String    @map("provider_id") @db.Uuid
  projectId      String?   @map("project_id") @db.Uuid
  paymentId      String?   @db.Uuid
  subtotal       Decimal   @db.Decimal(10, 2)
  taxAmount      Decimal   @default(0.00) @map("tax_amount") @db.Decimal(10, 2)
  discountAmount Decimal   @default(0.00) @map("discount_amount") @db.Decimal(10, 2)
  platformFee    Decimal   @default(0.00) @db.Decimal(10, 2)
  totalAmount    Decimal   @map("total_amount") @db.Decimal(10, 2)
  currency       String    @default("MYR") @db.VarChar(3)
  status         String    @default("draft") @db.VarChar(50)
  issueDate      DateTime  @map("issue_date") @db.Date
  dueDate        DateTime  @map("due_date") @db.Date
  paidDate       DateTime? @map("paid_date") @db.Date
  notes          String?
  terms          String?
  invoiceData    Json?     @map("invoice_data")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  payments       Payment[]
  customer       User      @relation("InvoicesAsCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  project        Project?  @relation(fields: [projectId], references: [id])
  provider       User      @relation("InvoicesAsProvider", fields: [providerId], references: [id], onDelete: Cascade)

  @@map("invoices")
}

model Milestone {
  id                      String          @id @default(uuid()) @db.Uuid
  projectId               String          @db.Uuid
  title                   String
  description             String
  amount                  Float
  dueDate                 DateTime
  daysFromStart           Int?            @map("days_from_start")
  order                   Int             @default(1)
  status                  MilestoneStatus @default(PENDING)
  source                  MilestoneSource @default(FINAL)
  isPaid                  Boolean         @default(false)
  paidAt                  DateTime?
  proposalId              String?         @db.Uuid
  deliverables            Json?
  startDeliverables       Json?           @map("start_deliverables")
  submitDeliverables      Json?           @map("submit_deliverables")
  approvedAt              DateTime?
  approvedBy              String?         @db.Uuid
  submittedAt             DateTime?
  submissionAttachmentUrl String?         @map("submission_attachment_url")
  submissionNote          String?         @map("submission_note")
  revisionNumber          Int             @default(0) @map("revision_number")
  submissionHistory       Json?           @map("submission_history")
  disputes                Dispute[]
  project                 Project         @relation(fields: [projectId], references: [id])
  Proposal                Proposal?       @relation(fields: [proposalId], references: [id])
  payments                Payment[]
}

model Payment {
  id                    String        @id @default(uuid()) @db.Uuid
  projectId             String        @db.Uuid
  milestoneId           String?       @db.Uuid
  stripePaymentIntentId String?       @map("stripe_payment_intent_id")
  stripeTransferId      String?       @map("stripe_transfer_id")
  stripeRefundId        String?       @map("stripe_refund_id")
  stripeChargeId        String?       @map("stripe_charge_id")
  amount                Float
  currency              String        @default("MYR") @db.VarChar(3)
  platformFeeAmount     Float         @default(0) @map("platform_fee_amount")
  providerAmount        Float         @map("provider_amount")
  method                PaymentMethod
  status                PaymentStatus
  invoiceId             String?       @db.Uuid
  escrowedAt            DateTime?     @map("escrowed_at")
  releasedAt            DateTime?     @map("released_at")
  releaseScheduledFor   DateTime?     @map("release_scheduled_for")
  bankTransferStatus    String?       @map("bank_transfer_status")
  bankTransferDate      DateTime?     @map("bank_transfer_date")
  bankTransferRef       String?       @map("bank_transfer_ref")
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  metadata              Json?
  Dispute               Dispute[]
  Invoice               Invoice?      @relation(fields: [invoiceId], references: [id])
  milestone             Milestone?    @relation(fields: [milestoneId], references: [id])
  project               Project       @relation(fields: [projectId], references: [id])
  Settings              Settings[]    @relation("PaymentToSettings")
}

model PlatformFeeConfig {
  id            String    @id @default(uuid()) @db.Uuid
  percentage    Float     @default(10.0)
  fixedAmount   Float     @default(0.0)
  minAmount     Float     @default(0.0)
  maxAmount     Float?
  currency      String    @default("MYR")
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("platform_fee_configs")
}

model Message {
  id              String      @id @default(uuid()) @db.Uuid
  projectId       String?     @map("project_id") @db.Uuid
  senderId        String      @map("sender_id") @db.Uuid
  receiverId      String      @map("receiver_id") @db.Uuid
  messageType     MessageType @default(text) @map("message_type")
  subject         String?     @db.VarChar(255)
  content         String
  attachments     String[]
  isRead          Boolean     @default(false) @map("is_read")
  readAt          DateTime?   @map("read_at") @db.Timestamptz(6)
  parentMessageId String?     @map("parent_message_id") @db.Uuid
  messageThreadId String?     @map("message_thread_id") @db.Uuid
  isSystemMessage Boolean     @default(false) @map("is_system_message")
  priority        String      @default("normal") @db.VarChar(20)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  parentMessage   Message?    @relation("MessageReplies", fields: [parentMessageId], references: [id])
  replies         Message[]   @relation("MessageReplies")
  project         Project?    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  receiver        User        @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  sender          User        @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model ConversationReport {
  id                String                   @id @default(uuid()) @db.Uuid
  reporterId        String                   @map("reporter_id") @db.Uuid
  reportedUserId    String                   @map("reported_user_id") @db.Uuid
  reason            ConversationReportReason
  additionalDetails String?                  @map("additional_details")
  status            String                   @default("PENDING") @db.VarChar(20)
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  reported          User                     @relation("ConversationReportsAgainst", fields: [reportedUserId], references: [id], onDelete: Cascade)
  reporter          User                     @relation("ConversationReportsByReporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@map("conversation_reports")
}

model SavedProvider {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  providerId String   @db.Uuid
  createdAt  DateTime @default(now())
  provider   User     @relation("ProviderSavedByUsers", fields: [providerId], references: [id], onDelete: Cascade)
  user       User     @relation("UserSavedProviders", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, providerId])
  @@map("saved_providers")
}

model SavedCompany {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  companyId String   @db.Uuid
  createdAt DateTime @default(now())
  company   User     @relation("CompanySavedByProviders", fields: [companyId], references: [id], onDelete: Cascade)
  user      User     @relation("UserSavedCompanies", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@map("saved_companies")
}

model SupportConversation {
  id                 String                    @id @default(uuid()) @db.Uuid
  userId             String                    @db.Uuid
  status             SupportConversationStatus @default(OPEN)
  handoffRequestedAt DateTime?                 @map("handoff_requested_at") @db.Timestamptz(6)
  takenOverByAdminId String?                   @map("taken_over_by_admin_id") @db.Uuid
  createdAt          DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  adminReads         SupportConversationRead[]
  user               User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages           SupportMessage[]

  @@index([userId])
  @@map("support_conversations")
}

model SupportConversationRead {
  id             String              @id @default(uuid()) @db.Uuid
  conversationId String              @map("conversation_id") @db.Uuid
  adminUserId    String              @map("admin_user_id") @db.Uuid
  lastReadAt     DateTime            @map("last_read_at") @db.Timestamptz(6)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  conversation   SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, adminUserId])
  @@index([adminUserId])
  @@map("support_conversation_reads")
}

model SupportMessage {
  id             String              @id @default(uuid()) @db.Uuid
  conversationId String              @map("conversation_id") @db.Uuid
  senderType     SupportSenderType   @map("sender_type")
  senderUserId   String?             @map("sender_user_id") @db.Uuid
  content        String
  attachments    String[]            @default([])
  metadata       Json?
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  conversation   SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("support_messages")
}

model SupportReferenceDocument {
  id        String                  @id @default(uuid()) @db.Uuid
  name      String                  @map("name") @db.VarChar(255)
  slug      String                  @unique @db.VarChar(100)
  fileKey   String                  @map("file_key") @db.VarChar(500)
  fileUrl   String?                 @map("file_url") @db.VarChar(1000)
  indexedAt DateTime?               @map("indexed_at") @db.Timestamptz(6)
  createdAt DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  chunks    SupportReferenceChunk[]

  @@map("support_reference_documents")
}

model SupportReferenceChunk {
  id         String                   @id @default(uuid()) @db.Uuid
  documentId String                   @map("document_id") @db.Uuid
  content    String
  embedding  Json
  page       Int?                     @db.SmallInt
  createdAt  DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  document   SupportReferenceDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("support_reference_chunks")
}

model KycDocument {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @db.Uuid
  type        KycDocType
  fileUrl     String
  filename    String
  mimeType    String?
  status      KycDocStatus @default(uploaded)
  reviewNotes String?
  reviewedBy  String?      @db.Uuid
  uploadedAt  DateTime     @default(now())
  reviewedAt  DateTime?
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
}

model Dispute {
  id                  String        @id @default(uuid()) @db.Uuid
  paymentId           String?       @db.Uuid
  projectId           String        @db.Uuid
  raisedById          String        @db.Uuid
  milestoneId         String?       @db.Uuid
  reason              String
  description         String
  contestedAmount     Float?
  suggestedResolution String?
  attachments         String[]      @default([])
  status              DisputeStatus @default(OPEN)
  resolution          String?
  resolutionNotes     Json?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  milestone           Milestone?    @relation(fields: [milestoneId], references: [id])
  payment             Payment?      @relation(fields: [paymentId], references: [id])
  project             Project       @relation(fields: [projectId], references: [id])
  raisedBy            User          @relation(fields: [raisedById], references: [id])
}

model AiDraft {
  id          String    @id @default(uuid()) @db.Uuid
  type        DraftType
  referenceId String    @db.Uuid
  summary     Json
  version     Int       @default(1)
  sourceData  Json?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([type, referenceId])
  @@map("ai_drafts")
}

model AdminSettings {
  id                    Int      @id @default(autoincrement())
  /// Default UI locale for new visitors (before they choose a language): en | id | ar
  defaultLocale         String   @default("en")
  platformName          String
  platformDescription   String?
  supportEmail          String
  contactPhone          String?
  platformUrl           String?
  platformCommission    Float    @default(0)
  withdrawalFee         Float    @default(0)
  minimumWithdrawal     Int      @default(0)
  paymentProcessingTime Int      @default(0)
  smtpHost              String?
  smtpPort              Int?     @default(587)
  smtpUsername          String?
  smtpPassword          String?
  emailNotifications    Boolean  @default(true)
  smsNotifications      Boolean  @default(false)
  pushNotifications     Boolean  @default(true)
  marketingEmails       Boolean  @default(true)
  twoFactorRequired     Boolean  @default(false)
  sessionTimeout        Int      @default(30)
  passwordMinLength     Int      @default(8)
  maxLoginAttempts      Int      @default(5)
  maintenanceMode       Boolean  @default(false)
  newRegistrations      Boolean  @default(true)
  projectCreation       Boolean  @default(true)
  paymentProcessing     Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

